{
  "name": "synorch",
  "version": "0.3.0",
  "description": "Provider-neutral AI orchestration structure generator for Codex and Claude Code.",
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "codex",
    "claude-code",
    "cli"
  ],
  "license": "MIT",
  "author": "Tunahan Tuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TunahanTuna/synorch.git"
  },
  "homepage": "https://github.com/TunahanTuna/synorch#readme",
  "bugs": {
    "url": "https://github.com/TunahanTuna/synorch/issues"
  },
  "type": "module",
  "bin": {
    "syn": "dist/cli.js",
    "synorch": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill-sources",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/write-build-info.mjs",
    "install:global": "node scripts/install-global.mjs",
    "link:global": "pnpm build && npm install -g .",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm check",
    "release:dry-run": "npm publish --dry-run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@earendil-works/pi-tui": "0.87.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "unpdf": "^1.8.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@xterm/headless": "6.0.0",
    "typescript": "^5.9.3"
  }
}
